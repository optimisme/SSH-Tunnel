{
  "sourceLanguage": "en",
  "strings": {
    "A local port is in use by another process.": {
      "comment": "Log line",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un port local està ocupat per un altre procés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro proceso está usando un puerto local."
          }
        }
      }
    },
